{
  "version": 2,
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/items", "dest": "api/items.py" },
    { "src": "/api/booster", "dest": "api/booster.py" },
    { "src": "/api/submit", "dest": "api/submit.py" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
