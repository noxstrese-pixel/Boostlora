{
  "version": 2,
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/items",
      "destination": "/api/items.py"
    },
    {
      "source": "/api/booster",
      "destination": "/api/booster.py"
    },
    {
      "source": "/api/submit",
      "destination": "/api/submit.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
