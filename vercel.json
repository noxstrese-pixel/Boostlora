{
  "version": 2,
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/items",
      "dest": "api/items.py"
    },
    {
      "src": "/api/booster",
      "dest": "api/booster.py"
    },
    {
      "src": "/api/submit",
      "dest": "api/submit.py"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
