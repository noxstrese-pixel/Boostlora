{
  "version": 2,
  "builds": [
    {
      "src": "index.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "source": "/api/submit/(.*)",
      "destination": "index.py"
    },
    {
      "source": "/(.*)",
      "destination": "index.html"
    }
  ]
}
